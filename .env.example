# Copy to .env and fill in. Variables starting with VITE_ are built into the
# browser bundle, so only public values belong there. Everything else stays on
# the server (Vercel functions).

# --- Firebase web app (public; Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: push notifications for owners (Project settings > Cloud Messaging >
# Web Push certificates > Generate key pair). Public by design.
VITE_FIREBASE_VAPID_KEY=

# --- Firebase Admin (secret; a service account key from Project settings > Service accounts)
FIREBASE_CLIENT_EMAIL=
# Keep the \n line breaks, wrapped in double quotes.
FIREBASE_PRIVATE_KEY=
# Optional: defaults to VITE_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=

# --- AI (secret; server only: never use a VITE_ name for these).
# Claude answers visitors and writes FAQs (Claude Console > API keys); Gemini
# (Google AI Studio) takes over when Claude is unavailable. Either alone works.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Billing with Lemon Squeezy (Pro plan)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
VITE_LEMONSQUEEZY_PRO_CHECKOUT_URL=
VITE_LEMONSQUEEZY_PRO_YEARLY_CHECKOUT_URL=
# Optional: the customer portal link shown under "Manage billing".
VITE_LEMONSQUEEZY_BILLING_URL=

# --- Email alerts with Resend (optional; new leads, missed live chats)
RESEND_API_KEY=
# A sender on your verified Resend domain.
EMAIL_FROM=Askio <notifications@getaskio.xyz>
# Optional: the site address used in email links. Defaults to https://www.getaskio.xyz.
APP_URL=
# Optional: where alerts about Askio itself go, such as AI replies failing.
# Defaults to support@getaskio.xyz.
OPS_ALERT_EMAIL=

# --- Shopify app (optional; only for the Shopify integration)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# --- Nightly cleanup cron (any long random string; Vercel sends it to the cron)
CRON_SECRET=

# --- Error monitoring with Sentry (optional)
VITE_SENTRY_DSN=
# Build-time only, to upload source maps.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Optional: defaults to the EU region (https://de.sentry.io/). Use https://sentry.io/ for a US organization.
SENTRY_URL=

# --- Local development: where /api calls go when running `npm run dev`.
# Defaults to the live site. Point it at `vercel dev` to run the API locally.
VITE_API_PROXY_TARGET=

{
  "functions": {
    "api/ai/generate-faq.js": {
      "maxDuration": 60
    },
    "api/ai/[action].js": {
      "maxDuration": 20
    },
    "api/mcp.js": {
      "maxDuration": 60
    }
  },
  "regions": [
    "cdg1"
  ],
  "crons": [
    {
      "path": "/api/cron/cleanup-rate-limits",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,OPTIONS,POST,PUT,DELETE"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version"
        }
      ]
    },
    {
      "source": "/.well-known/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/chatbot-embed.js",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript"
        }
      ]
    },
    {
      "source": "/((?!chatbot/|api/).*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/chatbot/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "ALLOWALL"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/chatbot-embed.js",
      "destination": "/chatbot-embed.js"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/account/oauth-resource-metadata"
    },
    {
      "source": "/.well-known/oauth-protected-resource/(.*)",
      "destination": "/api/account/oauth-resource-metadata"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/account/oauth-server-metadata"
    },
    {
      "source": "/.well-known/oauth-authorization-server/(.*)",
      "destination": "/api/account/oauth-server-metadata"
    },
    {
      "source": "/.well-known/openid-configuration",
      "destination": "/api/account/oauth-server-metadata"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDoc(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function ownsExistingChatbot() {
      return signedIn() && resource.data.user_id == request.auth.uid;
    }

    // Askio's operator, marked by a custom claim set with scripts/set-admin.mjs.
    // Admins get read-only access here; every admin action goes through the server.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // Suspension is set by an admin through the server; owners can't change it.
    // A suspended owner can still sign in and read their data, but not change it.
    function notSuspended() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('suspended', false) != true;
    }

    function suspensionUnchanged() {
      return request.resource.data.get('suspended', false) == resource.data.get('suspended', false);
    }

    match /users/{userId} {
      allow read: if ownsUserDoc(userId) || isAdmin();
      allow create: if ownsUserDoc(userId) && !('suspended' in request.resource.data);

      // Billing and limit fields are set by the server only.
      allow update: if ownsUserDoc(userId)
        && request.resource.data.plan == resource.data.plan
        && request.resource.data.subscriptionStatus == resource.data.subscriptionStatus
        && request.resource.data.aiChatbotLimit == resource.data.aiChatbotLimit
        && request.resource.data.isPro == resource.data.isPro
        && request.resource.data.get('aiReplyLimit', null) == resource.data.get('aiReplyLimit', null)
        && suspensionUnchanged()
        && request.resource.data.get('suspendedReason', null) == resource.data.get('suspendedReason', null);

      // Deleting the profile would drop a suspension, so suspended owners can't.
      allow delete: if ownsUserDoc(userId) && resource.data.get('suspended', false) != true;
    }

    match /chatbot_configs/{configId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.aiEnabled == false
        && request.resource.data.get('suspended', false) == false
        && notSuspended();

      allow update: if ownsExistingChatbot()
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.aiEnabled == resource.data.aiEnabled
        && suspensionUnchanged()
        && notSuspended();

      allow delete: if ownsExistingChatbot() && notSuspended();
    }

    // Leads, analytics and unanswered questions are written by anonymous
    // visitors through the widget, and belong to the chatbot's owner. Each
    // record carries ownerId, checked against the chatbot on create, so the
    // owner's queries (where ownerId == uid) are provably theirs alone.
    // Records are also held to the exact fields, sizes and server timestamp
    // the widget writes, so they can't be backdated, padded or junked.
    function chatbotPath(chatbotId) {
      return /databases/$(database)/documents/chatbot_configs/$(chatbotId);
    }

    function validVisitorRecord() {
      return request.resource.data.chatbotId is string
        && exists(chatbotPath(request.resource.data.chatbotId))
        && request.resource.data.ownerId == get(chatbotPath(request.resource.data.chatbotId)).data.user_id
        && get(chatbotPath(request.resource.data.chatbotId)).data.get('suspended', false) != true;
    }

    function ownsRecord() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    function fieldsOnly(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }

    function stampedNow() {
      return request.resource.data.timestamp == request.time;
    }

    function textUpTo(field, max) {
      return request.resource.data[field] is string
        && request.resource.data[field].size() > 0
        && request.resource.data[field].size() <= max;
    }

    function optionalTextUpTo(field, max) {
      return !(field in request.resource.data) || textUpTo(field, max);
    }

    // The anonymous browser id can still be empty while the widget starts up.
    function validToken() {
      return !('anonymousToken' in request.resource.data)
        || request.resource.data.anonymousToken == null
        || (request.resource.data.anonymousToken is string && request.resource.data.anonymousToken.size() <= 64);
    }

    match /leads/{leadId} {
      allow create: if validVisitorRecord()
        && fieldsOnly(['chatbotId', 'ownerId', 'email', 'timestamp', 'anonymousToken'])
        && textUpTo('email', 254)
        && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && stampedNow()
        && validToken();
      allow read: if ownsRecord();
      allow update, delete: if ownsRecord() && notSuspended();
    }

    match /analytics_events/{eventId} {
      allow create: if validVisitorRecord()
        && fieldsOnly(['chatbotId', 'ownerId', 'type', 'question', 'userQuery', 'timestamp', 'anonymousToken'])
        && request.resource.data.type in ['faq_matched', 'suggestion_clicked', 'ai_generated']
        && optionalTextUpTo('question', 1000)
        && optionalTextUpTo('userQuery', 2000)
        && stampedNow()
        && validToken();
      allow read: if ownsRecord();
      allow update, delete: if ownsRecord() && notSuspended();
    }

    match /unanswered_queries/{queryId} {
      allow create: if validVisitorRecord()
        && fieldsOnly(['chatbotId', 'ownerId', 'query', 'timestamp', 'anonymousToken'])
        && textUpTo('query', 2000)
        && stampedNow()
        && validToken();
      allow read: if ownsRecord();
      allow update, delete: if ownsRecord() && notSuspended();
    }

    match /feedback/{feedbackId} {
      // The widget reads a visitor's own rating by its id to avoid asking twice;
      // listing ratings is limited to the chatbot's owner.
      allow get: if true;
      allow list: if ownsRecord();
      allow create: if !exists(/databases/$(database)/documents/feedback/$(feedbackId))
        && validVisitorRecord()
        && fieldsOnly(['chatbotId', 'ownerId', 'isPositive', 'timestamp', 'anonymousToken'])
        && request.resource.data.isPositive is bool
        && stampedNow()
        && request.resource.data.anonymousToken is string
        && request.resource.data.anonymousToken.size() > 0
        && request.resource.data.anonymousToken.size() <= 64
        && feedbackId == request.resource.data.chatbotId + '_' + request.resource.data.anonymousToken;
      allow update, delete: if false;
    }

    // Monthly AI reply counts, keyed "{uid}_{YYYY-MM}". Only the server writes
    // them; owners can read their own, including a month with no replies yet.
    match /ai_usage/{usageId} {
      allow read: if (signedIn() && usageId.matches(request.auth.uid + '_[0-9]{4}-[0-9]{2}')) || isAdmin();
      allow write: if false;
    }

    // A record of every admin action, written by the server.
    match /admin_log/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Per-minute request counters for the AI chat endpoint. Server only.
    match /ai_rate_limits/{windowId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

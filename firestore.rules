rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDoc(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function ownsChatbot() {
      return signedIn() && resource.data.user_id == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if ownsUserDoc(userId);
      allow create: if ownsUserDoc(userId);
      allow update: if ownsUserDoc(userId)
        && request.resource.data.plan == resource.data.plan
        && request.resource.data.subscriptionStatus == resource.data.subscriptionStatus
        && request.resource.data.aiChatbotLimit == resource.data.aiChatbotLimit
        && request.resource.data.isPro == resource.data.isPro;
      allow delete: if ownsUserDoc(userId);
    }

    match /chatbot_configs/{chatbotId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if ownsChatbot()
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.aiEnabled == resource.data.aiEnabled;
      allow delete: if ownsChatbot();
    }
  }
}

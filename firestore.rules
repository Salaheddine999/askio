rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDoc(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function ownsExistingChatbot() {
      return signedIn() && resource.data.user_id == request.auth.uid;
    }

    // Askio's operator, marked by a custom claim set with scripts/set-admin.mjs.
    // Admins get read-only access here; every admin action goes through the server.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // Suspension is set by an admin through the server; owners can't change it.
    // A suspended owner can still sign in and read their data, but not change it.
    function notSuspended() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('suspended', false) != true;
    }

    // A new profile, as sign-up writes it: the free plan, the signed-in
    // account's own email, and nothing else. Plan, limits, billing ids and
    // suspension are written by the server only (webhooks, admin actions).
    function isNewFreeProfile() {
      let d = request.resource.data;
      return d.keys().hasOnly(['email', 'name', 'createdAt', 'aiScansCount', 'isPro', 'plan', 'subscriptionStatus', 'aiChatbotLimit', 'language'])
        && d.get('email', '') == request.auth.token.get('email', '').lower()
        && d.get('name', '') is string && d.get('name', '').size() <= 80
        && d.get('plan', 'free') == 'free'
        && d.get('subscriptionStatus', 'inactive') == 'inactive'
        && d.get('isPro', false) == false
        && d.get('aiChatbotLimit', 0) == 0
        && d.get('aiScansCount', 0) == 0;
    }

    // The only fields the dashboard edits. Email stays the signed-in
    // account's, since alerts and replies are sent to it.
    function isProfileEdit() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['name', 'emailAlerts', 'language', 'pushTokens'])
        && d.get('name', '') is string && d.get('name', '').size() <= 80
        && d.get('emailAlerts', {}) is map
        && d.get('language', 'en') is string && d.get('language', 'en').size() <= 8
        && d.get('pushTokens', []) is list && d.get('pushTokens', []).size() <= 20;
    }

    match /users/{userId} {
      allow read: if ownsUserDoc(userId) || isAdmin();
      allow create: if ownsUserDoc(userId) && isNewFreeProfile();
      allow update: if ownsUserDoc(userId) && isProfileEdit();
      // Accounts are deleted through /api/account/delete, which also cancels
      // billing and removes the account's data. Deleting the profile from the
      // browser would let it be re-created with other fields.
      allow delete: if false;
    }

    match /chatbot_configs/{configId} {
      // The widget loads one chatbot by its id. Listing is limited to the
      // owner's own chatbots (and admins), so nobody can enumerate customers.
      allow get: if true;
      allow list: if isAdmin() || (signedIn() && resource.data.user_id == request.auth.uid);

      // Chatbots are created and edited through /api/chatbots/save, which
      // checks the plan and cleans every field. The dashboard writes only two
      // things directly: pausing a chatbot, and adding an FAQ from Analytics.
      allow create: if false;

      allow update: if ownsExistingChatbot()
        && notSuspended()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive', 'faqData', 'lastUpdated'])
        && request.resource.data.get('isActive', true) is bool
        && request.resource.data.get('faqData', []) is list
        && request.resource.data.get('faqData', []).size() <= 200;

      allow delete: if ownsExistingChatbot() && notSuspended();
    }

    // Leads, analytics events, unanswered questions and ratings come from
    // anonymous visitors through the widget. The server writes them
    // (POST /api/ai/record), checking each one and rate-limiting visitors, so
    // nobody can create them here. Each carries the chatbot owner's ownerId.
    function ownsRecord() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Owners may only mark a record handled, never rewrite what the server
    // stored (its owner, chatbot, time or contents).
    function isMarkResolved() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved'])
        && request.resource.data.resolved is bool;
    }

    match /leads/{leadId} {
      allow read: if ownsRecord();
      allow update: if ownsRecord() && notSuspended() && isMarkResolved();
      allow delete: if ownsRecord() && notSuspended();
      allow create: if false;
    }

    match /analytics_events/{eventId} {
      allow read: if ownsRecord();
      allow update: if ownsRecord() && notSuspended() && isMarkResolved();
      allow delete: if ownsRecord() && notSuspended();
      allow create: if false;
    }

    match /unanswered_queries/{queryId} {
      allow read: if ownsRecord();
      allow update: if ownsRecord() && notSuspended() && isMarkResolved();
      allow delete: if ownsRecord() && notSuspended();
      allow create: if false;
    }

    match /feedback/{feedbackId} {
      // The widget reads a visitor's own rating by its id to avoid asking twice;
      // listing ratings is limited to the chatbot's owner.
      allow get: if true;
      allow list: if ownsRecord();
      allow create, update, delete: if false;
    }

    // Saved conversations (Pro, opt-in per chatbot), written by the server and
    // readable only by the chatbot's owner, not by admins. Owners may delete
    // them; the nightly cleanup removes ones idle for 90 days.
    // Live chat replies come straight from the owner's dashboard, so they
    // reach the visitor at once. Same checks as /api/account/live-reply:
    // a Pro owner, not suspended, on a chat that's live or whose visitor
    // wrote in the last 30 minutes, adding exactly one reply of their own.
    function isProOwner() {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return user.get('plan', 'free') in ['pro', 'enterprise'] && user.get('suspended', false) != true;
    }

    function canJoinLive() {
      let status = resource.data.get('liveStatus', null);
      return status in ['waiting', 'active']
        || (status != null
          && resource.data.get('lastMessageAt', null) != null
          && request.time < resource.data.lastMessageAt + duration.value(30, 'm'));
    }

    function isOwnerReply() {
      let before = resource.data.get('messages', []);
      let after = request.resource.data.get('messages', []);
      let reply = after[after.size() - 1];
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['messages', 'messageCount', 'lastMessageAt', 'liveStatus', 'agentName'])
        && resource.data.get('messageCount', 0) < 200
        && after.size() == before.size() + 1
        // Earlier messages unchanged (an empty range is an error in rules).
        && (before.size() == 0 || after[0:before.size()] == before)
        && reply.keys().hasOnly(['role', 'text', 'at', 'name'])
        && reply.role == 'agent'
        && reply.text is string && reply.text.size() > 0 && reply.text.size() <= 1000
        && reply.at is int
        && reply.get('name', '') is string && reply.get('name', '').size() <= 40
        && request.resource.data.messageCount == resource.data.get('messageCount', 0) + 1
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.liveStatus == 'active';
    }

    // "Sara is typing…": only this one field, stamped with the server's time.
    function isOwnerTyping() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['agentTypingAt'])
        && request.resource.data.agentTypingAt == request.time;
    }

    function isOwnerEndingChat() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['liveStatus', 'liveEndedAt'])
        && request.resource.data.liveStatus == 'ended'
        && request.resource.data.liveEndedAt == request.time;
    }

    match /conversations/{conversationId} {
      // During live chat the visitor's widget follows its own conversation.
      // Its id holds the visitor's random session id, so only they know it;
      // listing stays owner-only.
      allow get: if ownsRecord() || resource.data.get('liveStatus', null) != null;
      allow list: if ownsRecord();
      allow delete: if ownsRecord() && notSuspended();
      allow update: if ownsRecord() && isProOwner()
        && ((canJoinLive() && (isOwnerReply() || isOwnerTyping())) || isOwnerEndingChat());
      allow create: if false;
    }

    // Whether an owner is online for live chat. Widgets read it; only the
    // owner writes it, stamped with the server's time.
    match /presence/{userId} {
      allow read: if true;
      allow create, update: if ownsUserDoc(userId)
        && notSuspended()
        && request.resource.data.keys().hasOnly(['online', 'lastSeen', 'availableUntil'])
        && request.resource.data.online is bool
        && request.resource.data.lastSeen == request.time
        // With phone notifications on, you stay reachable for a while after
        // closing the dashboard, at most 12 hours ahead.
        && (!('availableUntil' in request.resource.data)
          || (request.resource.data.availableUntil is timestamp
            && request.resource.data.availableUntil <= request.time + duration.value(12, 'h')));
      allow delete: if ownsUserDoc(userId);
    }

    // Monthly AI reply counts, keyed "{uid}_{YYYY-MM}". Only the server writes
    // them; owners can read their own, including a month with no replies yet.
    match /ai_usage/{usageId} {
      allow read: if (signedIn() && usageId.matches(request.auth.uid + '_[0-9]{4}-[0-9]{2}')) || isAdmin();
      allow write: if false;
    }

    // A record of every admin action, written by the server.
    match /admin_log/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Shopify stores connected to a chatbot. The server writes them when an
    // install finishes; the owner sees and removes their own.
    match /shopify_connections/{connectionId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if false;
    }

    // Per-minute request counters for the AI chat endpoint. Server only.
    match /ai_rate_limits/{windowId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
